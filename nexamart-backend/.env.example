# Copy to .env and fill in — do NOT commit real secrets.
# Loading .env is up to you (e.g. `export $(cat .env | xargs)` on macOS/Linux,
# or set these as real environment variables / run configuration on Windows).

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
JWT_SECRET=change-me-to-a-long-random-string

# Only needed when running with -Dspring-boot.run.profiles=docker
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexamart
DB_USER=nexamart
DB_PASSWORD=nexamart
